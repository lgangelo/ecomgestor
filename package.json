{
  "name": "ecommerce-manager",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@ecommerce-manager/web",
    "dev:api": "npm run dev --workspace=@ecommerce-manager/api",
    "build": "npm run prisma:generate && npm run build --workspace=@ecommerce-manager/shared && npm run build --workspace=@ecommerce-manager/shared-server && npm run build --workspace=@ecommerce-manager/database && npm run build --workspace=@ecommerce-manager/integrations && npm run build --workspace=@ecommerce-manager/ui && npm run build --workspace=@ecommerce-manager/api && npm run build --workspace=@ecommerce-manager/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "prisma:generate": "npm run prisma:generate --workspace=@ecommerce-manager/database",
    "prisma:migrate": "npm run prisma:migrate --workspace=@ecommerce-manager/database",
    "prisma:seed": "npm run seed --workspace=@ecommerce-manager/database",
    "create-admin": "npm run create-admin --workspace=@ecommerce-manager/api",
    "recompute-order-totals": "npm run recompute-order-totals --workspace=@ecommerce-manager/api",
    "backfill-tiktok-product-details": "npm run backfill-tiktok-product-details --workspace=@ecommerce-manager/api",
    "check-marketplace-fees": "npm run check-marketplace-fees --workspace=@ecommerce-manager/api",
    "check-failed-jobs": "npm run check-failed-jobs --workspace=@ecommerce-manager/api",
    "check-unmatched-sku": "npm run check-unmatched-sku --workspace=@ecommerce-manager/api",
    "check-stock-invariant": "npm run check-stock-invariant --workspace=@ecommerce-manager/api",
    "check-sku-stock-history": "npm run check-sku-stock-history --workspace=@ecommerce-manager/api",
    "backfill-order-customer-name": "npm run backfill-order-customer-name --workspace=@ecommerce-manager/api",
    "link-and-reprocess-order": "npm run link-and-reprocess-order --workspace=@ecommerce-manager/api",
    "list-orders-for-month": "npm run list-orders-for-month --workspace=@ecommerce-manager/api",
    "check-product-variants": "npm run check-product-variants --workspace=@ecommerce-manager/api",
    "check-tiktok-product-detail": "npm run check-tiktok-product-detail --workspace=@ecommerce-manager/api",
    "check-tiktok-order-detail": "npm run check-tiktok-order-detail --workspace=@ecommerce-manager/api",
    "manually-link-order-item": "npm run manually-link-order-item --workspace=@ecommerce-manager/api",
    "check-job-schedulers": "npm run check-job-schedulers --workspace=@ecommerce-manager/api",
    "sync-order-finance": "npm run sync-order-finance --workspace=@ecommerce-manager/api"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
