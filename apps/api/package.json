{
  "name": "@ecommerce-manager/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "ts-node -r tsconfig-paths/register src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "create-admin": "node dist/cli/create-admin.js",
    "recompute-order-totals": "node dist/cli/recompute-order-totals.js",
    "backfill-tiktok-product-details": "node dist/cli/backfill-tiktok-product-details.js",
    "check-marketplace-fees": "node dist/cli/check-marketplace-fees.js",
    "check-failed-jobs": "node dist/cli/check-failed-jobs.js",
    "check-unmatched-sku": "node dist/cli/check-unmatched-sku.js",
    "check-stock-invariant": "node dist/cli/check-stock-invariant.js",
    "check-sku-stock-history": "node dist/cli/check-sku-stock-history.js",
    "backfill-order-customer-name": "node dist/cli/backfill-order-customer-name.js",
    "link-and-reprocess-order": "node dist/cli/link-and-reprocess-order.js",
    "list-orders-for-month": "node dist/cli/list-orders-for-month.js",
    "check-product-variants": "node dist/cli/check-product-variants.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@ecommerce-manager/database": "*",
    "@ecommerce-manager/shared": "*",
    "@ecommerce-manager/shared-server": "*",
    "@ecommerce-manager/integrations": "*",
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/schedule": "^4.1.1",
    "archiver": "^7.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "bullmq": "^5.12.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.1",
    "@types/archiver": "^6.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/multer": "^1.4.11",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.15",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
