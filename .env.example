# ---------------------------------------------------------------------------
# Geral
# ---------------------------------------------------------------------------
NODE_ENV=production

# ---------------------------------------------------------------------------
# Banco de dados
# PostgreSQL é instalado diretamente na VM Linux (NÃO roda em container).
# Do host da VM ele normalmente escuta em 127.0.0.1:5432; dos containers Docker
# ele é acessado via host.docker.internal (mapeado no docker-compose.yml).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://ecommerce_manager:CHANGE_ME@host.docker.internal:5432/ecommerce_manager?schema=public

# ---------------------------------------------------------------------------
# Redis (roda em container, ver docker-compose.yml)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# API — porta interna do container (o acesso externo é sempre via Traefik)
# ---------------------------------------------------------------------------
PORT=3001

# ---------------------------------------------------------------------------
# Armazenamento de XMLs fiscais enviados (upload real — ver módulo Fiscal).
# Em produção deve apontar para um volume Docker persistente (já mapeado no
# docker-compose.yml como `fiscal-xml-storage`) — nunca para um caminho efêmero do container.
# ---------------------------------------------------------------------------
FISCAL_XML_STORAGE_DIR=/data/fiscal-xml

# Modo de armazenamento de XML fiscal (Fase 4 — ver docs/phase4-review.md, item A).
# REFERENCE_ONLY (default, recomendado): o XML nunca é gravado em disco, só a referência fiscal
# extraída é persistida. PERSIST (legado): grava o arquivo em FISCAL_XML_STORAGE_DIR, igual ao
# comportamento anterior à Fase 4.
XML_STORAGE_MODE=REFERENCE_ONLY

# ---------------------------------------------------------------------------
# Armazenamento de fotos de produto (capa + por variação) — mesmo esquema do XML fiscal acima:
# em produção deve apontar para o volume Docker `product-image-storage` (já mapeado no
# docker-compose.yml), nunca para um caminho efêmero do container.
#
# Só usado como FALLBACK quando o Cloudflare R2 abaixo não está configurado, ou pra continuar
# servindo fotos que já estavam salvas em disco antes de migrar pro R2 — nunca apagar enquanto
# houver foto antiga referenciando esse caminho.
# ---------------------------------------------------------------------------
PRODUCT_IMAGE_STORAGE_DIR=/data/product-images

# ---------------------------------------------------------------------------
# Cloudflare R2 (armazenamento de objetos compatível com S3) — dois buckets separados por nível
# de sensibilidade, NUNCA o mesmo bucket pros dois:
#
# - R2_IMAGES_BUCKET: bucket PÚBLICO (com um Custom Domain do R2 apontando pra ele, ver
#   R2_IMAGES_PUBLIC_BASE_URL) — só fotos de produto/variação, nada sensível.
# - R2_FISCAL_BUCKET: bucket PRIVADO (SEM Custom Domain nem "URL de desenvolvimento público"
#   habilitados no painel do R2) — XML de NF-e, dado fiscal/cliente. Só a API S3 autenticada
#   (as credenciais abaixo) consegue ler; nunca vira link direto.
#
# Ausente (default): o código cai automaticamente pro fallback de disco local acima — nenhuma
# das duas features quebra sem R2 configurado.
# ---------------------------------------------------------------------------
# Endpoint da API S3 do R2 — painel R2 do bucket, campo "API S3", tirando o "/<nome-do-bucket>"
# do final (o bucket é passado por parâmetro em cada chamada, não faz parte do endpoint).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Gerado em Cloudflare → R2 → Manage R2 API Tokens → Create API Token (permissão "Object Read &
# Write", escopo pelos buckets específicos acima) — o Secret só é exibido uma vez na criação.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_IMAGES_BUCKET=
# Custom Domain configurado no painel do bucket público acima (com "Acesso: Habilitado") — sem
# barra no final.
R2_IMAGES_PUBLIC_BASE_URL=
# Opcional e independente das fotos — sem isso, XML fiscal em modo PERSIST continua indo pro
# disco local (FISCAL_XML_STORAGE_DIR) mesmo com as fotos já migradas pro R2.
R2_FISCAL_BUCKET=

# ---------------------------------------------------------------------------
# Segredos JWT — gere valores aleatórios fortes, nunca reutilize os de exemplo.
# Sugestão: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET

# ---------------------------------------------------------------------------
# Domínios / URLs (usados pelo Traefik, CORS e cookies)
#
# Topologia atual: UM domínio só para tudo (WEB_DOMAIN = API_DOMAIN) — o Traefik roteia por
# caminho (/api/* vai para a API, o resto vai para o site), não por subdomínio separado. O
# domínio fica atrás de Cloudflare Tunnel, que termina o HTTPS na borda; o Traefik só recebe
# HTTP puro internamente (ver infra/traefik/traefik.yml).
# ---------------------------------------------------------------------------
WEB_DOMAIN=ecomgestor.example.com
API_DOMAIN=ecomgestor.example.com
WEB_APP_URL=https://ecomgestor.example.com
NEXT_PUBLIC_API_URL=https://ecomgestor.example.com/api
# Vazio: como é o mesmo host para site e API, o cookie não precisa (nem deve) de um atributo
# Domain explícito — o padrão (escopo só do host exato) já é o que se quer aqui.
COOKIE_DOMAIN=

# API_INTERNAL_URL não precisa ser definido aqui — já vem fixo no docker-compose.yml
# (aponta para o nome do serviço ecommerce-api dentro da rede Docker). É o que o Next.js usa
# para chamadas servidor-a-servidor (Server Components), em vez de NEXT_PUBLIC_API_URL (que é
# só para o navegador e pode não ter DNS/TLS prontos ainda, ou sofrer bloqueio de hairpin NAT).

# ---------------------------------------------------------------------------
# Teste sem domínio/TLS reais (ex.: acesso direto por IP, sem Traefik) — NUNCA usar em produção
# com tráfego saindo para a internet.
# ---------------------------------------------------------------------------
# Deixe vazio quando WEB_DOMAIN/API_DOMAIN forem um IP: o atributo Domain do cookie não é válido
# para hosts que são IP puro, e o navegador rejeita o cookie inteiro se ele vier definido.
# COOKIE_DOMAIN=
#
# 'false' desliga o atributo Secure dos cookies de sessão (necessário em HTTP puro, sem TLS —
# cookies Secure são recusados pelo navegador fora de HTTPS). Omitido ou qualquer outro valor
# mantém o padrão (Secure sempre que NODE_ENV=production).
# COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Seed de desenvolvimento (opcional — se omitido, uma senha aleatória é gerada
# e exibida uma única vez no terminal ao rodar `npm run prisma:seed`)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@altenburg.com.br
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# Criptografia de credenciais de integração (access_token/refresh_token em repouso).
# Gere um valor aleatório forte, nunca reutilize os de exemplo nem os segredos de JWT.
# Sugestão: openssl rand -base64 48
# ---------------------------------------------------------------------------
INTEGRATION_SECRETS_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET_MIN_16_CHARS

# ---------------------------------------------------------------------------
# TikTok Shop (Fase 3 — ver docs/integrations/tiktok.md para o fluxo OAuth completo).
# Obtidos ao criar um Custom App no TikTok Shop Partner Center. Se ausentes, a aplicação
# continua funcionando normalmente e a tela de Integrações mostra "não configurado".
# ---------------------------------------------------------------------------
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# NÃO é o App Key — é um identificador separado, exibido logo abaixo do nome do app na página
# "App & Service" do Partner Center. Usar o App Key aqui faz a tela de autorização responder
# "This service does not exist", mesmo com um App Key/Secret válidos (eles funcionam normalmente
# nas chamadas de API — só não servem como service_id da URL de autorização).
TIKTOK_SERVICE_ID=
# Precisa usar API_DOMAIN, não WEB_DOMAIN: a rota de callback (/api/integrations/tiktok/callback)
# roda no serviço ecommerce-api, e o Traefik roteia só por Host (sem path-based routing) — usar o
# domínio do web aqui faria o callback do OAuth cair no Next.js em vez de chegar na API.
TIKTOK_REDIRECT_URI=https://api.example.com/api/integrations/tiktok/callback

# Nunca "true" por padrão (seção 38-39): mantém o estoque da TikTok apenas em modo de
# comparação até o operador decidir explicitamente habilitar o envio automático.
TIKTOK_INVENTORY_PUSH_ENABLED=false

# Intervalo (minutos) do job de reconciliação periódica de pedidos (seção 23).
TIKTOK_RECONCILE_INTERVAL_MINUTES=15

# ---------------------------------------------------------------------------
# Shopee Open Platform (esqueleto — ver docs/integrations/shopee.md). Nenhum endpoint de
# negócio (produtos/pedidos/estoque) foi confirmado ainda contra uma conta real; só a
# autenticação (conectar/desconectar a loja) está pronta pra testar. Se ausentes, a aplicação
# continua funcionando normalmente e a tela de Integrações mostra "não configurado".
# ---------------------------------------------------------------------------
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Mesmo cuidado do TIKTOK_REDIRECT_URI acima: precisa usar API_DOMAIN, não WEB_DOMAIN.
SHOPEE_REDIRECT_URI=https://api.example.com/api/integrations/shopee/callback
# true (default) usa o sandbox público e estável da Shopee (partner.test-stable.shopeemobile.com)
# — nunca mude para produção sem ter confirmado o fluxo completo no sandbox primeiro.
SHOPEE_SANDBOX=true

# ---------------------------------------------------------------------------
# Mercado Livre (esqueleto — ver docs/integrations/mercado-livre.md). Nenhum endpoint de negócio
# (itens/pedidos/estoque) foi confirmado ainda contra uma conta real; só a autenticação (conectar/
# desconectar a conta) está pronta pra testar. Se ausentes, a aplicação continua funcionando
# normalmente e a tela de Integrações mostra "não configurado".
#
# Obtidos criando uma aplicação em developers.mercadolivre.com.br → "Minhas aplicações" → "Criar
# nova aplicação". Diferente da Shopee, o Mercado Livre NÃO tem sandbox — testes acontecem contra
# a própria produção usando "usuários de teste" (ver o próprio doc de pesquisa, seção 9).
# ---------------------------------------------------------------------------
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
# Mesmo cuidado do TIKTOK_REDIRECT_URI/SHOPEE_REDIRECT_URI acima: precisa usar API_DOMAIN, não
# WEB_DOMAIN, e precisa ser cadastrado EXATAMENTE igual na aplicação do Mercado Livre (Callback
# URL), incluindo protocolo e barra final — o Mercado Livre rejeita o code se não bater.
MERCADOLIVRE_REDIRECT_URI=https://api.example.com/api/integrations/mercadolivre/callback

# Acréscimo (%) aplicado SÓ no preço publicado no Mercado Livre (nunca no preço interno nem no
# de outros canais) — a taxa de lá é mais alta que a da TikTok, então o preço de lá precisa de
# uma margem a mais pra manter o mesmo lucro líquido. 0 (default) não aplica nenhum acréscimo.
MERCADOLIVRE_PRICE_MARKUP_PERCENT=15

# Intervalo (minutos) da reconciliação automática de pedidos do Mercado Livre (mesmo papel de
# TIKTOK_RECONCILE_INTERVAL_MINUTES). Default 15.
MERCADOLIVRE_RECONCILE_INTERVAL_MINUTES=15

# Mesma trava dupla da TIKTOK_INVENTORY_PUSH_ENABLED: desabilitado por padrão, nunca envia
# estoque pro Mercado Livre sem isso E o toggle por integração (tela da integração) ligados.
MERCADOLIVRE_INVENTORY_PUSH_ENABLED=false

# ---------------------------------------------------------------------------
# Geração de título/descrição de produto por IA (botão "Gerar com IA" no cadastro/edição de
# produto) — integração neutra: escolha UM provedor via AI_PROVIDER, nunca mais de um ativo ao
# mesmo tempo. Ausente (default), o recurso fica desligado sem quebrar o resto da aplicação.
# ---------------------------------------------------------------------------
# "anthropic", "openai" ou "gemini" — deixe em branco para desligar o recurso.
AI_PROVIDER=

# Só usado se AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-opus-5

# Só usado se AI_PROVIDER=openai.
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o

# Só usado se AI_PROVIDER=gemini — camada gratuita real (sem cartão de crédito), chave criada em
# https://aistudio.google.com/apikey.
GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.6-flash
